using EmailServiceApplication.Models;
using Microsoft.EntityFrameworkCore;

namespace EmailServiceApplication.Data

{
    public class DatabaseContext:DbContext
    {
        public DatabaseContext(DbContextOptions<DatabaseContext> options): base(options)
        {
        }

        // ------------------ DbSets ------------------
        public DbSet<User> Users { get; set; }
        public DbSet<Email> Emails { get; set; }
        public DbSet<EmailRecipient> EmailRecipients { get; set; }
        public DbSet<Attachment> Attachments { get; set; }
        public DbSet<DepartmentGroup> DepartmentGroups { get; set; }

        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            base.OnModelCreating(modelBuilder);

            // ------------------ User ------------------
            modelBuilder.Entity<User>()
                .HasMany(u => u.SentEmails)
                .WithOne(e => e.Sender)
                .HasForeignKey(e => e.SenderId)
                .OnDelete(DeleteBehavior.Restrict);

            // We do NOT configure ReceivedEmails because it's coming from EmailRecipient


            // ------------------ EmailRecipient ------------------
            modelBuilder.Entity<EmailRecipient>()
                .HasOne(er => er.Email)
                .WithMany(e => e.Recipients)
                .HasForeignKey(er => er.EmailId)
                .OnDelete(DeleteBehavior.Cascade);

            modelBuilder.Entity<EmailRecipient>()
                .HasOne(er => er.User)
                .WithMany()
                .HasForeignKey(er => er.UserId)
                .OnDelete(DeleteBehavior.Cascade);


            // ------------------ Attachments ------------------
            modelBuilder.Entity<Attachment>()
                .HasOne(a => a.Email)
                .WithMany(e => e.Attachments)
                .HasForeignKey(a => a.EmailId)
                .OnDelete(DeleteBehavior.Cascade);


            // ------------------ DepartmentGroup (Many-to-Many: Groups <-> Users) ------------------
            modelBuilder.Entity<DepartmentGroup>()
                .HasMany(g => g.Users)
                .WithMany()
                .UsingEntity(j => j.ToTable("GroupUsers"));
        }

    }
}
